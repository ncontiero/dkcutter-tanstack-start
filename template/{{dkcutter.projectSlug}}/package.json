{
  "name": "{{dkcutter.projectSlug}}",
  "type": "module",
  "version": "{{dkcutter.projectVersion}}",
  "private": true,
  "packageManager": "",
  "description": "{{dkcutter.description}}",
  "author": "{{dkcutter.authorName|safe}}",
  "license": "MIT",
  "scripts": {
    "dev": "{{ 'bun --bun ' if dkcutter.useBunRuntime }}vite dev --port 3000",
    "build": "{{ 'bun --bun ' if dkcutter.useBunRuntime }}vite build",
    "preview": "{{ 'bun --bun ' if dkcutter.useBunRuntime }}vite preview",
    "deploy": "{{ dkcutter.pkgManager }} run build && wrangler deploy",
    "start": "{{ 'bun run' if dkcutter.useBunRuntime else 'node' }}{{ ' --import ./.output/server/instrument.server.mjs' if dkcutter.useSentry }} .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "cf-typegen": "wrangler types",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "lint": "eslint .",
    "lint:fix": "{{ dkcutter.pkgManager }} run lint {{ '-- ' if dkcutter.pkgManager == 'npm' }}--fix",
    "typecheck": "tsc --noEmit",
    "check": "{{ dkcutter.pkgManager }} run lint && {{ dkcutter.pkgManager }} run typecheck",
    "pre-commit": "{{ 'nano-staged' if dkcutter.useNanoStaged else 'lint-staged' }}",
    "commit-msg": "commitlint --edit",
    "prepare": "husky",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "postinstall": "{{ dkcutter.pkgManager }} run generate-routes"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.27",
    "@clerk/tanstack-react-start": "1.5.0",
    "@hookform/resolvers": "5.7.1",
    "@inlang/paraglide-js-react": "1.0.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/tanstackstart-react": "10.70.0",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.44",
    "@tanstack/router-plugin": "1.168.30",
    "@trigger.dev/sdk": "4.5.10",
    "@unpic/react": "1.0.2",
    "better-auth": "1.6.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@inlang/paraglide-js": "2.23.2",
    "@ncontiero/eslint-config": "8.4.5",
    "@netlify/vite-plugin-tanstack-start": "1.3.17",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-cli": "1.167.28",
    "@trigger.dev/build": "4.5.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nano-staged": "1.0.2",
    "prisma": "7.9.1",
    "shadcn": "4.17.0",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "trigger.dev": "4.5.10",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "engines": {
    "node": ">=24"
  },
  "{{ 'nano-staged' if dkcutter.useNanoStaged else 'lint-staged' }}": {
    "*": "{{ dkcutter.pkgManager }} run lint:fix"
  }
}
